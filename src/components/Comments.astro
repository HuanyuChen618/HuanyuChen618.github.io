---
// Likes (reactions) and comments via giscus, stored as GitHub Discussions in this site's repo
// (category "Announcements": only the owner and giscus can start threads). One thread per page path.
// Visitors need a GitHub account to react or comment. Moderate at
// https://github.com/HuanyuChen618/huanyuchen618.github.io/discussions
---
<section class="comments" aria-label="Likes and comments">
  <h2>Likes and comments</h2>
  <p class="muted comments-note">React with an emoji or leave a comment. Signing in with GitHub is required.</p>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="HuanyuChen618/huanyuchen618.github.io"
    data-repo-id="R_kgDOVkL2fA"
    data-category="Announcements"
    data-category-id="DIC_kwDOVkL2fM4DKksT"
    data-mapping="pathname"
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</section>

<style>
  .comments { margin-top: 3em; padding-top: 1.5em; border-top: 1px solid rgba(127, 127, 127, .25); }
  .comments h2 { margin-top: 0; }
  .comments-note { margin-top: -.4em; font-size: .9rem; }
</style>
