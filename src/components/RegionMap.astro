---
// Region map: one numbered pin per store branch, with a matching list below. Click a branch to zoom to it.
// Stores with no known location are listed after the map instead. Leaflet and the OpenStreetMap tiles load
// only when the map scrolls near the viewport.
interface Loc { label: string; lat: number; lon: number; }
interface Store { name: string; locs: Loc[]; note?: string; }
interface Props { stores: Store[]; region: string; }
const { stores, region } = Astro.props;
const pinned = stores.filter((s) => s.locs.length);
const unpinned = stores.filter((s) => !s.locs.length);
---
<div class="rmap" data-stores={JSON.stringify(pinned)}>
  <div class="rmap-canvas" role="img" aria-label={`Map of the shops in ${region}.`}></div>
  <div class="rmap-bar"><button type="button" class="rmap-reset">show all</button></div>
  <ol class="rmap-list">
    {pinned.map((s, i) => (
      <li>
        <strong>{s.name}</strong>{' '}
        {s.locs.map((l, j) => (
          <button type="button" class="rmap-loc" data-i={i} data-j={j}>{l.label}</button>
        ))}
      </li>
    ))}
  </ol>
  {unpinned.length > 0 && (
    <p class="rmap-off muted">Not on the map: {unpinned.map((s, k) => (
      <span><strong>{s.name}</strong>{s.note && ` (${s.note})`}{k < unpinned.length - 1 ? '; ' : '.'}</span>
    ))}</p>
  )}
</div>

<script>
  type Loc = { label: string; lat: number; lon: number };
  type Store = { name: string; locs: Loc[] };
  let leaflet: Promise<any> | undefined;
  const loadLeaflet = () => leaflet ??= new Promise((ok, fail) => {
    const css = document.createElement('link');
    css.rel = 'stylesheet'; css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    document.head.appendChild(css);
    const js = document.createElement('script');
    js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    js.onload = () => ok((window as any).L); js.onerror = fail;
    document.head.appendChild(js);
  });

  const init = async (box: HTMLElement) => {
    const L = await loadLeaflet();
    const stores: Store[] = JSON.parse(box.dataset.stores!);
    const map = L.map(box.querySelector('.rmap-canvas'), { scrollWheelZoom: false, zoomSnap: 0.25 });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);
    const pins: any[][] = [];
    const all: [number, number][] = [];
    stores.forEach((s, i) => {
      pins[i] = s.locs.map((l) => {
        all.push([l.lat, l.lon]);
        const icon = L.divIcon({ className: 'rmap-pin', html: `<span>${i + 1}</span>`, iconSize: [22, 22], iconAnchor: [11, 11] });
        return L.marker([l.lat, l.lon], { icon, title: `${s.name}, ${l.label}`, keyboard: false })
          .bindTooltip(`${s.name} · ${l.label}`, { direction: 'top', offset: [0, -10] }).addTo(map);
      });
    });
    const fit = () => all.length === 1 ? map.setView(all[0], 15) : map.fitBounds(all, { padding: [28, 28], maxZoom: 15 });
    fit();
    box.querySelector('.rmap-reset')!.addEventListener('click', fit);
    box.querySelectorAll<HTMLButtonElement>('.rmap-loc').forEach((b) => b.addEventListener('click', () => {
      const m = pins[+b.dataset.i!][+b.dataset.j!];
      map.flyTo(m.getLatLng(), 17, { duration: 0.8 });
      m.openTooltip();
    }));
  };

  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) { io.unobserve(e.target); init(e.target as HTMLElement); }
  }), { rootMargin: '400px' });
  document.querySelectorAll<HTMLElement>('.rmap').forEach((b) => io.observe(b));
</script>

<style is:global>
  .rmap { margin: 1.2em 0 1.6em; }
  .rmap-canvas { position: relative; z-index: 0; height: 360px; border-radius: 8px; border: 1px solid var(--line); background: var(--line); }
  .rmap-bar { display: flex; justify-content: flex-end; margin-top: .3em; }
  .rmap-reset, .rmap-loc {
    font: inherit; font-size: .85rem; background: none; border: 1px solid var(--line); border-radius: 999px;
    padding: .05em .6em; margin: .15em .15em; color: var(--link); cursor: pointer;
  }
  .rmap-reset:hover, .rmap-loc:hover { border-color: var(--link); }
  .rmap-list { margin: .4em 0 0; padding-left: 1.6em; font-size: .95rem; line-height: 1.7; }
  .rmap-off { font-size: .9rem; margin: .4em 0 0; }
  .rmap-pin span {
    display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%;
    background: #8b1a1a; color: #fff; font: 600 11px/1 system-ui, sans-serif; border: 2px solid #fff;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .35);
  }
  @media (prefers-color-scheme: dark) {
    .rmap .leaflet-tile-pane { filter: invert(1) hue-rotate(180deg) brightness(.9) contrast(.85); }
  }
  @media (max-width: 640px) { .rmap-canvas { height: 300px; } }
</style>
