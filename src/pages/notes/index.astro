---
// The Notes index lists series only. Cards (the individual notes) are reached through a series, or by their own address.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesTile from '../../components/SeriesTile.astro';
import { seriesList, notes } from '../../data/notes.js';
const inSeries = new Set(seriesList.flatMap((s) => s.cards.map((n) => n.slug)));
const loose = notes.filter((n) => !inSeries.has(n.slug));
---
<BaseLayout title="Notes — Huanyu Chen"
  description="Short research notes by Huanyu Chen on simulation, mechanics and optimization, grouped into series: one idea per card, with interactive demos, each card citable and versioned.">
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Huanyu Chen — Notes" href="/notes/rss.xml" />
  </Fragment>
  <h1>Notes</h1>
  <p class="notes-lede">Short cards, one idea each, with a demo to play with. Pick a series and scroll: the cards play in order, and you can skip or jump.</p>

  <div class="series-grid">
    {seriesList.map((s, i) => <SeriesTile s={s} eager={i < 2} />)}
  </div>

  {loose.length > 0 && (
    <p class="muted"><small>Not in a series yet: {loose.map((n: any, k: number) => <>{k > 0 && ' · '}<a href={`/notes/${n.slug}`}>{n.title}</a></>)}</small></p>
  )}

  <p class="muted notes-foot"><small>Drawn from my papers. Every card has a permanent address, a version number and a BibTeX entry ·
    <a href="/notes/rss.xml">RSS</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></small></p>
</BaseLayout>

<style>
  .notes-lede { font-size: 1.1em; margin-top: -.3em; }
  .series-grid { display: grid; grid-template-columns: 1fr; gap: 1.6em; margin-top: 1.6em; }
  .notes-foot { margin-top: 2.5em; }
</style>
