const L = (label, lat, lon) => ({ label, lat, lon });
const SGV = [
  { name: 'Ikka Sizzling Pot', locs: [L('San Gabriel', 34.07994, -118.10394)] },
  { name: 'Nature Pagoda', locs: [L('San Gabriel', 34.07934, -118.10425)] },
  { name: 'Dong Ting Chun', locs: [L('San Gabriel', 34.08062, -118.09149)] },
  { name: 'Mo-Mo Paradise', locs: [L('Arcadia', 34.12975, -118.02836)] },
  { name: 'Hodori BBQ', locs: [L('Arcadia', 34.13381, -118.05229)] },
  { name: 'Tai Er', locs: [L('Arcadia', 34.13369, -118.05238)] },
  { name: 'Auntie Qiu Kitchen', locs: [L('Arcadia', 34.12439, -118.05923)] },
  { name: 'Lunasia', locs: [L('Pasadena', 34.14615, -118.14551)] },
  { name: 'Guangfa Grassland Mongolian', locs: [L('Rowland Heights', 33.9948, -117.89049)] },
