  { name: "Porto's", locs: [L('Buena Park', 33.85242, -117.99741)] },
  { name: 'Mitsuwa', locs: [L('Costa Mesa', 33.68146, -117.88406)] },
  { name: 'Alittle Tea', locs: [], note: 'Irvine' },
];
const BAY = [
  { name: 'Big Mug Coffee Roaster', locs: [L('Santa Clara', 37.35155, -121.98099)] },
  { name: 'Sulbing', locs: [L('Santa Clara', 37.352, -121.9819)] },
  { name: 'HEYTEA', locs: [L('Sunnyvale', 37.36819, -122.03552)] },
  { name: 'Crumbl', locs: [L('Mountain View', 37.40202, -122.11368)] },
  { name: 'The Coffee Movement', locs: [L('San Francisco', 37.79475, -122.4103)] },
];
const NY = [
  { name: 'HEYTEA', locs: [L('Times Square', 40.75353, -73.98741), L('Flushing', 40.76172, -73.8314)] },
  { name: 'Molly Tea', locs: [L('Upper West Side', 40.80479, -73.96659)] },
];
const AWAY = [
  { name: 'Rare Tea', locs: [L('Kirkland, WA', 47.67789, -122.19917)] },
  { name: "Rolld Ice Cream", locs: [L('Santa Barbara', 34.41968, -119.70031)] },
  { name: 'Molly Tea', locs: [L('Philadelphia', 39.95489, -75.19758)] },
