---
import BaseLayout from '../../layouts/BaseLayout.astro';

// One entry per post. group: 'places' or a year (trips are listed newest first within each year).
// tags drive the filter chips; blurb shows as a hover tooltip.
const posts = [
  {
    "href": "/misc/joshua-tree",
    "title": "Four Visits to the Same Desert",
    "group": "places",
    "when": "4 visits · 2022–25",
    "where": "Joshua Tree, CA",
    "tags": [
      "places",
      "wangcai"
    ],
    "img": "/misc/joshua-tree/card-dusk.jpg",
    "blurb": "Four trips to Joshua Tree, made easy by the area's affordable homestays and mostly spent looking up: Keys View at 3 a.m., Jumbo Rocks under storm clouds, Orion over the Joshua trees, and a field of giant desert hands with Wangcai."
  },
  {
    "href": "/misc/las-vegas",
    "title": "Las Vegas, Again",
    "group": "places",
    "when": "7 visits · 2022–26",
    "where": "Las Vegas, NV",
    "tags": [
      "places"
    ],
    "img": "/misc/las-vegas/card-nyny-night.jpg",
    "blurb": "Seven visits to the same four miles of boulevard, because the luxury hotels are surprisingly affordable and the shows are wonderful: a fake Venice, the STRAT twice, the Sphere both dark and lit, and a dawn walk past the Luxor with Wangcai."
  },
  {
    "href": "/misc/bay-area",
    "title": "The Bay Area, Again and Again",
    "group": "places",
    "when": "5 visits · 2022–26",
    "where": "San Francisco Bay Area",
    "tags": [
      "places"
    ],
    "img": "/misc/bay-area/golden-gate-2022.jpg",
    "blurb": "Close to Napa, more in San Francisco than one trip can hold, and on the way to Oregon: a castle winery, Highway 1 down to 17-Mile Drive, Twin Peaks at night and the skyline from Treasure Island."
  },
  {
    "href": "/misc/san-diego",
    "title": "San Diego, Again",
    "group": "places",
    "when": "8 visits · 2022–26",
    "where": "San Diego, CA",
    "tags": [
      "places"
    ],
    "img": "/misc/san-diego/card-embracing-peace.jpg",
    "blurb": "Not a far drive, and close to the border: Geisel Library, La Jolla's harbor seals by day and by night, a Halloween panda, Christmas in LEGOLAND's Miniland, an Easter balloon, NeurIPS, and the USS Midway with our dog."
  },
  {
    "href": "/misc/views-from-above",
    "title": "Views from Up High",
    "group": "collections",
    "when": "21 views · 2022–26",
    "where": "13 cities, from Las Vegas to Shenzhen",
    "tags": [
      "collections"
    ],
    "img": "/misc/views-from-above/griffith-2024.jpg",
    "blurb": "Every city I have looked down on, roughly from lowest to highest: three Ferris wheels, four high bars and rooftops, seven observation decks up to the 116th floor in Shenzhen, and five hills above cities, including the Baldwin Hills in wildfire smoke."
  },
  {
    "href": "/misc/stars",
    "title": "Connecting the Dots",
    "group": "collections",
    "when": "7 nights · 2022–25",
    "where": "Death Valley to Mauna Kea",
    "tags": [
      "collections"
    ],
    "img": "/misc/stars/mauna-kea-core.jpg",
    "blurb": "Nine night-sky photos from our trips, matched star by star to a catalogue and redrawn with their constellations: Orion over a Joshua tree, Mars in Taurus, the Milky Way's core from Mauna Kea and Perseus over the Klamath Basin."
  },
  {
    "href": "/misc/campuses",
    "title": "Brick, Stone and Concrete",
    "group": "collections",
    "when": "27 campuses · 2021–25",
    "where": "12 states, D.C., Canada and Australia",
    "tags": [
      "collections"
    ],
    "img": "/misc/campuses/ucsd-geisel.jpg",
    "blurb": "Every university campus we have walked through, sorted by what it is built of: colonial brick at Brown and Penn, Gothic towers at Yale and Pitt, Stanford's arcades, Berkeley's Campanile, Geisel Library's concrete, and USC as home."
  },
  {
    "href": "/misc/live-music",
    "title": "Phone Lights and Confetti",
    "group": "collections",
    "when": "23 shows · 2021–26",
    "where": "Los Angeles, Long Beach, Costa Mesa, Stanford and Las Vegas",
    "tags": [
      "collections"
    ],
