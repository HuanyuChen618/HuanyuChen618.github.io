const filters = [
  { id: 'all', label: 'All' },
  { id: 'places', label: 'Places' },
  { id: 'wangcai', label: 'Wangcai' },
  { id: 'siggraph', label: 'SIGGRAPH' },
  { id: 'holidays', label: 'Holidays' },
  { id: 'abroad', label: 'Abroad' },
];
const groups = ['places', ...[...new Set(posts.filter((p) => p.group !== 'places').map((p) => p.group))]];
const groupTitle = (g) => (g === 'places' ? 'Places we keep going back to' : g);
---
<BaseLayout title="Misc — Huanyu Chen" description="Travel and other writing by Huanyu Chen, outside research.">
  <h1>Misc</h1>
  <p class="muted">Things outside research: mostly road trips. {posts.length} posts.</p>

  <div class="chips" role="group" aria-label="Filter posts">
    {filters.map((f) => (
      <button type="button" class="chip" data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>{f.label}</button>
    ))}
  </div>

  {groups.map((g) => (
    <section class="misc-group" data-group={g}>
      <h2>{groupTitle(g)}</h2>
      <ul class="cards">
        {posts.filter((p) => p.group === g).map((p) => (
          <li class="card" data-tags={p.tags.join(' ')}>
            <a href={p.href} title={p.blurb}>
              <img src={p.img} alt="" loading="lazy" />
              <span class="card-title">{p.title}{p.tags.includes('wangcai') && <span class="dog" title="With Wangcai" aria-label="with Wangcai"> 🐕</span>}</span>
              <span class="card-meta">{p.when} · {p.where}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('.chip');
    function apply(id) {
      if (!document.querySelector('.chip[data-filter="' + id + '"]')) id = 'all';
      chips.forEach(function (c) { c.setAttribute('aria-pressed', c.dataset.filter === id ? 'true' : 'false'); });
      document.querySelectorAll('.card').forEach(function (card) {
        var tags = card.dataset.tags.split(' ');
        card.hidden = !(id === 'all' || tags.indexOf(id) !== -1);
      });
      document.querySelectorAll('.misc-group').forEach(function (g) {
        g.hidden = !g.querySelector('.card:not([hidden])');
      });
    }
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        var id = c.dataset.filter;
        history.replaceState(null, '', id === 'all' ? location.pathname : '#' + id);
        apply(id);
      });
    });
    apply((location.hash || '#all').slice(1));
  })();
</script>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 1.2em 0 .4em; }
  .chip { font: inherit; font-size: .9rem; padding: .3em .9em; border-radius: 999px; cursor: pointer;
          border: 1px solid rgba(127, 127, 127, .45); background: transparent; color: inherit; }
  .chip[aria-pressed="true"] { color: inherit; background: rgba(127, 127, 127, .22); border-color: rgba(127, 127, 127, .8); font-weight: 600; }
  .misc-group h2 { font-size: 1.15rem; margin: 1.6em 0 .6em; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px;
           grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); }
  .card a { display: block; color: inherit; text-decoration: none; }
  .card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; display: block;
              transition: transform .15s ease, box-shadow .15s ease; }
  .card a:hover img, .card a:focus-visible img { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0, 0, 0, .18); }
  .card-title { display: block; margin-top: .45em; font-weight: 600; font-size: .95rem; line-height: 1.3; }
  .card a:hover .card-title { text-decoration: underline; }
  .card-meta { display: block; font-size: .82rem; opacity: .7; margin-top: .15em; line-height: 1.3; }
  .dog { font-weight: 400; }
  @media (max-width: 480px) { .cards { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
</style>
