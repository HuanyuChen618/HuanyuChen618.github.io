// Timeline entries only for posts that are listed (published) here.
const timeline = timelineAll.filter((e) => posts.some((p) => p.href === '/misc/' + e.post));
// Year sections: every year that has a trip post or a timeline entry, newest first.
const inYear = (e, y) => e.start.slice(0, 4) <= y && (e.end || e.start).slice(0, 4) >= y;
const tlYears = timeline.flatMap((e) => {
  const a = Number(e.start.slice(0, 4)), b = Number((e.end || e.start).slice(0, 4));
  return Array.from({ length: b - a + 1 }, (_, i) => String(a + i));
});
const years = [...new Set([...posts.map((p) => p.group).filter((g) => /^\d{4}$/.test(g)), ...tlYears])].sort().reverse();
const groups = ['places', 'collections', ...years];
const isYear = (g) => /^\d{4}$/.test(g);
