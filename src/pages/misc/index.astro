    "title": "Pyramids, Iguanas and a Sea Turtle",
    "group": "2022",
    "when": "Jul",
    "where": "Cancún, Chichén Itzá, Tulum",
    "tags": [
      "abroad"
    ],
    "img": "/misc/cancun-2022/tulum-castillo.jpg",
