<BaseLayout title="Misc — Huanyu Chen" description="Travel and other writing by Huanyu Chen, outside research.">
  <h1>Misc</h1>
  <p class="muted">Things outside research: mostly road trips. {posts.length} posts.</p>

  <figure class="fridge">
    <div class="fridge-img">
      <img src={MEDIA + "/misc/fridge.webp"} alt="Our fridge door, covered in travel magnets: Vancouver, Seattle, Oregon, the Simpsons, Lake Tahoe, Chicago, Cleveland, Boston, New York, Delaware, two Maryland crabs, Georgia, Florida, Hawaii, Australia and more." width="1726" height="2103" />
      {magnets.map((m) => (
        <a class="spot" href={`/misc/${m.post}`} style={`left:${m.x}%;top:${m.y}%;width:${m.w}%;height:${m.h}%`} title={m.label} aria-label={`${m.label}: read the post`}></a>
      ))}
    </div>
    <figcaption>Our fridge, where every trip leaves a magnet. Click one to read about the trip it came from.</figcaption>
  </figure>

  <div class="chips" role="group" aria-label="Filter posts">
    {filters.map((f) => (
      <button type="button" class="chip" data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>{f.label}</button>
    ))}
  </div>

  {groups.map((g) => (
    <section class="misc-group" data-group={g}>
      {isYear(g) ? (
        <Fragment>
          <h2>{g} <span class="tl-count">· {timeline.filter((e) => inYear(e, g)).length} trips and outings</span></h2>
          <YearTimeline year={g} entries={timeline.filter((e) => inYear(e, g))} />
        </Fragment>
      ) : <h2>{groupTitle(g)}</h2>}
      <ul class="cards">
        {posts.filter((p) => p.group === g).map((p) => (
          <li class="card" data-tags={p.tags.join(' ')}>
            <a href={p.href} title={p.blurb}>
              <img src={MEDIA + p.img} alt="" loading="lazy" />
              <span class="card-title">{p.title}{p.tags.includes('wangcai') && <span class="dog" title="With Wangcai" aria-label="with Wangcai"> 🐕</span>}</span>
              <span class="card-meta">{p.when} · {p.where}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('.chip');
    function apply(id) {
      if (!document.querySelector('.chip[data-filter="' + id + '"]')) id = 'all';
      chips.forEach(function (c) { c.setAttribute('aria-pressed', c.dataset.filter === id ? 'true' : 'false'); });
      document.querySelectorAll('.card').forEach(function (card) {
        var tags = card.dataset.tags.split(' ');
        card.hidden = !(id === 'all' || tags.indexOf(id) !== -1);
      });
      // timelines show only in the unfiltered view; a year with no cards still shows its timeline there
      document.querySelectorAll('[data-timeline]').forEach(function (t) { t.hidden = id !== 'all'; });
      document.querySelectorAll('.misc-group').forEach(function (g) {
        var hasCard = !!g.querySelector('.card:not([hidden])');
        g.hidden = !(hasCard || (id === 'all' && g.querySelector('[data-timeline]')));
      });
    }
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        var id = c.dataset.filter;
        history.replaceState(null, '', id === 'all' ? location.pathname : '#' + id);
        apply(id);
      });
    });
    apply((location.hash || '#all').slice(1));
  })();
</script>

<style>
