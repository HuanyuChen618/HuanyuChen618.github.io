// Card body for /notes/material-zoo. Rendered on its own page and inside every series that uses it.
import Tex from '../components/Tex.astro';

// Table 1 of Chen & Barbič, SCA 2026, transcribed from the paper's LaTeX source. Δ(ν) = 11ν² − 18ν + 15.
const L = String.raw`\lambda_{\text{Lamé}}`, M = String.raw`\mu_{\text{Lamé}}`;
const rows: { group?: string; name: string; cite?: string; psi: string; lam: string; mu: string; scien: string; ri: string }[] = [
  { group: 'Seth-Hill and Hill families', name: 'Seth-Hill family (S.H.)', cite: '[Set64]',
    psi: String.raw`\frac{\mu}{\alpha^2}\textstyle\sum_i(\lambda_i^{\alpha}-1)^2+\frac{\lambda}{2\alpha^2}\big(-3+\sum_i\lambda_i^{\alpha}\big)^2`, lam: String.raw`\lambda`, mu: String.raw`\mu`, scien: String.raw`\alpha`, ri: '0' },
  { name: 'Linear Corotational (S.H. α = 1)',
    psi: String.raw`\mu\textstyle\sum_i(\lambda_i-1)^2+\frac{\lambda}{2}\big(-3+\sum_i\lambda_i\big)^2`, lam: String.raw`\lambda`, mu: String.raw`\mu`, scien: '1', ri: '0' },
  { name: 'St. Venant–Kirchhoff (S.H. α = 2)',
    psi: String.raw`\frac{\mu}{4}\textstyle\sum_i(\lambda_i^2-1)^2+\frac{\lambda}{8}\big(-3+\sum_i\lambda_i^2\big)^2`, lam: String.raw`\lambda`, mu: String.raw`\mu`, scien: '2', ri: '0' },
  { name: 'Hencky (S.H. α = 0)',
    psi: String.raw`\mu\textstyle\sum_i\log^2\lambda_i+\frac{\lambda}{2}\log^2 J`, lam: String.raw`\lambda`, mu: String.raw`\mu`, scien: '0', ri: '0' },
  { name: 'Symmetric Seth-Hill', cite: '[Baz98]',
    psi: String.raw`\frac{\mu}{4\alpha^2}\textstyle\sum_i\big(\lambda_i^{\alpha}-\frac{1}{\lambda_i^{\alpha}}\big)^2+\frac{\lambda}{8\alpha^2}\big(\sum_i(\lambda_i^{\alpha}-\frac{1}{\lambda_i^{\alpha}})\big)^2`, lam: String.raw`\lambda`, mu: String.raw`\mu`, scien: '0', ri: '0' },
  { name: 'Hill family', cite: '[Hil68]',
    psi: String.raw`\mu\textstyle\sum_i f^2(\lambda_i)+\frac{\lambda}{2}\big(\sum_i f(\lambda_i)\big)^2`, lam: String.raw`\lambda`, mu: String.raw`\mu`, scien: String.raw`1+f''(1)`, ri: '0' },
  { name: 'Volume-corrected Linear Corot.',
    psi: String.raw`\mu\textstyle\sum_i(\lambda_i-1)^2+\frac{\lambda}{2}\log^2 J`, lam: String.raw`\lambda`, mu: String.raw`\mu`,
    scien: String.raw`\frac{3(1-2\nu)(5-3\nu)}{\Delta(\nu)}`, ri: String.raw`\frac{2\sqrt{21}\,\nu(1-2\nu)}{\Delta(\nu)}` },
  { name: 'Volume-corrected StVK',
    psi: String.raw`\frac{\mu}{4}\textstyle\sum_i(\lambda_i^2-1)^2+\frac{\lambda}{2}\log^2 J`, lam: String.raw`\lambda`, mu: String.raw`\mu`,
    scien: String.raw`\frac{6(1-2\nu)(5-3\nu)}{\Delta(\nu)}`, ri: String.raw`\frac{4\sqrt{21}\,\nu(1-2\nu)}{\Delta(\nu)}` },
  { group: 'Neo-Hookean family', name: 'Neo-Hookean (standard)',
    psi: String.raw`\frac{\mu}{2}\big(-3+\textstyle\sum_i\lambda_i^2\big)-\mu\log J+\frac{\lambda}{2}\log^2 J`, lam: String.raw`\lambda`, mu: String.raw`\mu`,
    scien: String.raw`\frac{2(6\nu^2-13\nu+5)}{\Delta(\nu)}`, ri: String.raw`\frac{4\sqrt{21}\,|\nu(1-2\nu)|}{3\Delta(\nu)}` },
  { name: 'Neo-Hookean (Ogden)',
    psi: String.raw`\frac{\mu}{2}\big(-3+\textstyle\sum_i\lambda_i^2\big)-\mu\log J+\frac{\lambda}{2}(J-1)^2`, lam: String.raw`\lambda`, mu: String.raw`\mu`,
    scien: String.raw`\frac{9\nu^2+7\nu+10}{\Delta(\nu)}`, ri: String.raw`\frac{2|\nu|\sqrt{1641\nu^2-2838\nu+1434}}{3\Delta(\nu)}` },
  { name: 'Stable Neo-Hookean (Eq. 13 of [SGK18])',
    psi: String.raw`\frac{\mu}{2}\big(-3+\textstyle\sum_i\lambda_i^2\big)-\mu(J-1)+\frac{\lambda}{2}(J-1)^2`, lam: String.raw`\lambda-\mu`, mu: String.raw`\mu`,
    scien: String.raw`\frac{11\nu^2-16\nu+21}{\Delta(\nu)}`, ri: String.raw`\frac{2\sqrt3\sqrt{11\nu^4+4\nu^3+53\nu^2-114\nu+78}}{3\Delta(\nu)}` },
  { name: 'STS material', cite: '[PRWH*18]',
    psi: String.raw`\frac{\mu}{2}\big(-3+\textstyle\sum_i\lambda_i^2\big)-\mu\log J+\frac{\lambda}{2}\log^2 J+\frac{\mu_4}{8}\sum_i(\lambda_i^2-1)^4`, lam: String.raw`\lambda`, mu: String.raw`\mu`,
    scien: String.raw`\frac{2(6\nu^2-13\nu+5)}{\Delta(\nu)}`, ri: String.raw`\frac{4\sqrt{21}\,|\nu(1-2\nu)|}{3\Delta(\nu)}` },
  { group: 'Valanis-Landel family', name: 'Valanis-Landel (original)', cite: '[VL67]',
    psi: String.raw`2\mu\textstyle\sum_i\lambda_i(\log\lambda_i-1)+\frac{\lambda}{2}\log^2 J`, lam: String.raw`\lambda`, mu: String.raw`\mu`,
    scien: String.raw`\frac{2(6\nu^2-13\nu+5)}{\Delta(\nu)}`, ri: String.raw`\frac{4\sqrt{21}\,|\nu(1-2\nu)|}{3\Delta(\nu)}` },
  { name: 'Valanis-Landel (general f and h)', cite: '[Val22, CZB23]',
    psi: String.raw`\textstyle\sum_i f(\lambda_i)+h(J)`, lam: String.raw`h''(1)`, mu: String.raw`\frac{f''(1)}{2}`,
    scien: String.raw`1+\frac{\nu(11-\nu)h_3+(5-3\nu)(1-2\nu)f_3+4\nu(3+\nu)}{\Delta(\nu)}`,
    ri: String.raw`\frac{2|\nu|}{\sqrt3\,\Delta(\nu)}\Big(\Delta(\nu)(h_3+3)^2+7\big[(1-2\nu)(f_3-h_3)-2(1-\nu)(h_3+3)\big]^2\Big)^{1/2}` },
  { name: 'Peng-Landel', cite: '[PL72]',
    psi: String.raw`E\textstyle\sum_i\big(\lambda_i-1-\log\lambda_i-\frac16\log^2\lambda_i+\frac1{18}\log^3\lambda_i-\frac1{216}\log^4\lambda_i\big)`, lam: '0', mu: String.raw`\frac{E}{3}`, scien: String.raw`\frac23`, ri: '0' },
  { group: 'Geometric models', name: 'ARAP', cite: '[SA07]',
    psi: String.raw`\|F-R\|^2=\textstyle\sum_i(\lambda_i-1)^2`, lam: '0', mu: '1', scien: '1', ri: '0' },
  { name: 'Symmetric ARAP', cite: '[SPSH*17]',
    psi: String.raw`\frac{\mu}{2}\big(\|F-R\|^2+\|F^{-1}-R^{-1}\|^2\big)=\frac{\mu}{2}\textstyle\sum_i\big((\lambda_i-1)^2+(1-\frac1{\lambda_i})^2\big)`, lam: '0', mu: String.raw`\mu`, scien: '0', ri: '0' },
  { name: 'Symmetric Dirichlet', cite: '[SS15]',
    psi: String.raw`\frac12\big(\|F\|^2+\|F^{-1}\|^2\big)=\frac12\textstyle\sum_i\big(\lambda_i-\frac1{\lambda_i}\big)^2`, lam: '0', mu: '2', scien: '0', ri: '0' },
  { group: 'Series models', name: 'Ogden', cite: '[Ogd72]',
    psi: String.raw`\textstyle\sum_p\frac{\mu_p}{\alpha_p}\big(-3+\sum_i\lambda_i^{\alpha_p}\big)`, lam: '0', mu: String.raw`\sum_p\frac{\mu_p(\alpha_p-1)}{2}`,
    scien: String.raw`1+\frac{\sum_p\mu_p(\alpha_p-1)(\alpha_p-2)}{3\sum_p\mu_p(\alpha_p-1)}`, ri: '0' },
  { name: 'Mooney-Rivlin', cite: '[Moo40, Riv48]',
    psi: String.raw`C_1\big(-3+J^{-2/3}\textstyle\sum_i\lambda_i^2\big)+C_2\big(-3+J^{-4/3}\sum_i\lambda_i^2\lambda_{(1+i)\bmod 3}^2\big)`, lam: String.raw`-\frac{4(C_1+C_2)}{3}`, mu: String.raw`2(C_1+C_2)`,
    scien: String.raw`\frac{2(C_1-C_2)}{11(C_1+C_2)}`, ri: String.raw`\frac{4\sqrt6}{33}\,\frac{|C_1-C_2|}{|C_1+C_2|}` },
];
---
  <h2 id="one-language">One language for all of them</h2>
  <p>
    Isotropic hyperelastic materials are usually picked from a short list of families (St. Venant–Kirchhoff, Linear
    Corotational, Neo-Hookean, Ogden, ...), each with its own parameters. That makes it awkward to answer simple questions:
    are these two materials equally stiff? Is this one "more nonlinear" than that one? The table below answers both, for
    every material, in the same terms. Everything is written as a symmetric function of the principal stretches
    <Tex tex={String.raw`\lambda_1,\lambda_2,\lambda_3`} /> (the singular values of <Tex tex={String.raw`F`} />), with
    <Tex tex={String.raw`J=\lambda_1\lambda_2\lambda_3`} /> and <Tex tex={String.raw`\psi_{ij}=\partial^2\psi/\partial\lambda_i\partial\lambda_j`} />.
  </p>
  <p>
    <strong>Linear behavior.</strong> Expand <Tex tex={String.raw`\psi`} /> around the rest shape
    <Tex tex={String.raw`\lambda_i=1`} />. The constant and linear terms vanish, and by symmetry the quadratic term has only
    two distinct coefficients, <Tex tex={String.raw`\psi_{11}`} /> and <Tex tex={String.raw`\psi_{12}`} />. The paper proves
    that this quadratic truncation is always a Linear Corotational material (its Theorem 1), and that defines the Lamé
    parameters of <em>any</em> isotropic <Tex tex={String.raw`\psi`} /> (Eqs. 5–6):
  </p>
  <Tex block tex={String.raw`\lambda_{\text{Lamé}}=\psi_{12}(1,1,1),\qquad \mu_{\text{Lamé}}=\tfrac12\big(\psi_{11}(1,1,1)-\psi_{12}(1,1,1)\big).`} />
  <p>
    So the Linear Corotational material is special: it is the simplest possible isotropic material, the one with nothing
    beyond second order. For the families that already come with Lamé parameters, this definition agrees with them; for the
    others (Stable Neo-Hookean, Mooney–Rivlin, ARAP, ...) it tells you what their parameters actually mean.
  </p>
  <p>
    <strong>Weak nonlinearity.</strong> The next terms are cubic, and again symmetry leaves only three distinct coefficients,
    <Tex tex={String.raw`\psi_{111},\psi_{112},\psi_{123}`} />. Among materials with the same Lamé parameters, the paper
    defines a distance from these cubic terms (Eq. 27), projects every material onto the one-parameter Seth-Hill family
    (Hencky at α = 0, Linear Corotational at α = 1, St. Venant–Kirchhoff at α = 2), and calls the closest α the
    <em>Stretchability–Compressibility Index of Elastic Nonlinearity</em>, SCIEN (Eqs. 35–36):
  </p>
  <Tex block tex={String.raw`\text{SCIEN}(\psi)=1+\frac{(15\psi_{11}+6\psi_{12})\,\psi_{111}+(18\psi_{11}+24\psi_{12})\,\psi_{112}}{45\psi_{11}^2+24\psi_{12}^2+36\psi_{11}\psi_{12}}.`} />
  <p>
    SCIEN above 1 means the material stiffens under stretching and softens under compression, like silicone; below 1, the
    opposite, like foam. The Residual Index (RI, Eq. 40) is the distance that is left after the projection: how far the
    material is from being a Seth-Hill material at all.
  </p>

  <h2 id="table">The table</h2>
  <p class="muted"><small>Transcribed from the paper's source. Here <Tex tex={String.raw`\lambda,\mu`} /> are each
    material's native parameters, <Tex tex={String.raw`\nu=\lambda_{\text{Lamé}}/\big(2(\lambda_{\text{Lamé}}+\mu_{\text{Lamé}})\big)`} />
    is its Poisson ratio, <Tex tex={String.raw`\Delta(\nu)=11\nu^2-18\nu+15`} />, and for the general Valanis–Landel row
    <Tex tex={String.raw`f_3=f'''(1)/f''(1)`} />, <Tex tex={String.raw`h_3=h'''(1)/h''(1)`} /> (the original form has
    <Tex tex={String.raw`f_3=-1,\ h_3=-3`} />). Scroll sideways on a phone.</small></p>
  <div class="zoo-table-wrap">
    <table class="zoo-table">
      <thead><tr><th>Material</th><th><Tex tex={String.raw`\psi(\lambda_1,\lambda_2,\lambda_3)`} /></th><th><Tex tex={L} /></th><th><Tex tex={M} /></th><th>SCIEN</th><th>RI</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <>
            {r.group && <tr class="zoo-group"><td colspan="6">{r.group}</td></tr>}
            <tr>
              <td>{r.name}{r.cite && <span class="muted"> {r.cite}</span>}</td>
              <td><Tex tex={r.psi} /></td><td><Tex tex={r.lam} /></td><td><Tex tex={r.mu} /></td><td><Tex tex={r.scien} /></td><td><Tex tex={r.ri} /></td>
            </tr>
          </>
        ))}
      </tbody>
    </table>
  </div>
  <p>
    I re-derived every row numerically for this note: for each material, the Lamé parameters from finite-difference
    second derivatives at rest, SCIEN from finite-difference third derivatives (and, separately, by brute-force minimizing
    the distance of Eq. 35 over α), and RI from Eq. 40, at several Poisson ratios. All agree with the table to the accuracy of
    the finite differences (about <Tex tex={String.raw`10^{-5}`} />). The demo below repeats this check live.
  </p>

  <h2 id="demo">Try it: equalize, then compare</h2>
  <p>
    Pick a Poisson ratio. Every material is then <em>equalized</em> (Section 3.1 of the paper): its native parameters are
    set so that its <Tex tex={L} /> and <Tex tex={M} /> match the same target, with Young's modulus 1. Stable Neo-Hookean,
    for example, needs native <Tex tex={String.raw`\lambda=\lambda_{\text{Lamé}}+\mu_{\text{Lamé}}`} />. The geometric
    models and Peng–Landel, Ogden and Mooney–Rivlin have no free volume term, so they can only match <Tex tex={M} /> and
    keep their own <Tex tex={L} />. Then follow a deformation path and compare the curves.
  </p>
  <figure class="note-fig zoo-demo">
    <canvas id="zoo-canvas" width="880" height="460" aria-label="Interactive plot: energy density of equalized isotropic materials along a deformation path."></canvas>
    <div class="zoo-controls">
      <label>Poisson ratio ν <input type="range" id="zoo-nu" min="0" max="0.48" step="0.01" value="0.25" /> <span id="zoo-nuv"></span></label>
      <label>path <select id="zoo-path">
        <option value="uniaxial">uniaxial stretch (s, 1, 1)</option>
        <option value="uniform">uniform scaling (s, s, s)</option>
        <option value="isochoric">volume-preserving (s, 1/s, 1)</option>
      </select></label>
      <label>plot <select id="zoo-qty">
        <option value="energy">energy ψ</option>
        <option value="stress">dψ/ds</option>
      </select></label>
      <label><input type="checkbox" id="zoo-quad" checked /> shared quadratic truncation</label>
    </div>
    <div class="zoo-legend" id="zoo-legend"></div>
    <div class="zoo-read" id="zoo-read"></div>
    <figcaption>Curves: equalized materials (Young's modulus 1). Dashed: the quadratic truncation they share, a Linear
      Corotational material (it applies only to the materials that can match the target Poisson ratio). Gaps: the energy is
      undefined there (a logarithm of a non-positive stretch or volume). The table under the plot recomputes each checked
      material's parameters from its formula and compares them with the closed forms above.</figcaption>
  </figure>
  <p>
    What to look for. Near <Tex tex="s = 1" /> all the curves that can match the Poisson ratio sit on the dashed parabola:
    that is the equalization at work, and it is exactly what makes small deformations look the same in simulation. Away
    from rest they fan out. Along the two stretching paths, St. Venant–Kirchhoff (SCIEN 2) climbs fastest and Hencky (0)
    the slowest; under uniform scaling the volume terms take over, and Stable Neo-Hookean, whose
    <Tex tex={String.raw`(J-1)^2`} /> term grows like <Tex tex={String.raw`s^6`} />, overtakes everything. Two coincidences
    are worth spotting: along uniaxial stretch, equalized Stable Neo-Hookean is <em>exactly</em> Linear Corotational (both
    reduce to <Tex tex={String.raw`(\mu_{\text{Lamé}}+\lambda_{\text{Lamé}}/2)(s-1)^2`} />), and along the
    volume-preserving path the two Neo-Hookeans coincide, because <Tex tex="J = 1" /> there. Under uniaxial compression the
    polynomial materials stay finite through
    <Tex tex="s = 0" />, and St. Venant–Kirchhoff even returns to zero energy at <Tex tex="s = -1" />, a fully mirrored
    element; the logarithmic ones refuse to go there at all. Raise ν toward 0.5 and watch SCIEN of the volume-corrected and
    standard Neo-Hookean materials fall, while the Seth-Hill materials keep theirs (Figure 12 of the paper).
  </p>

  <h2 id="notes">Notes for implementers</h2>
  <ul>
    <li><strong>Constants do not matter.</strong> The table writes some energies up to an additive constant: the original
      Valanis–Landel energy equals <Tex tex={String.raw`-6\mu`} /> at rest, and
      <Tex tex={String.raw`\tfrac12(\|F\|^2+\|F^{-1}\|^2)`} /> is <Tex tex={String.raw`\tfrac12\sum_i(\lambda_i-1/\lambda_i)^2`} />
      plus 3. Neither changes forces or any entry of the table.</li>
    <li><strong>Rest stress.</strong> The derivation assumes the rest shape is stress-free. That holds for every row
      except Ogden, whose rest stress is <Tex tex={String.raw`\sum_p\mu_p`} />: the table's Ogden entries assume
      <Tex tex={String.raw`\sum_p\mu_p=0`} /> (the demo uses two terms, <Tex tex={String.raw`\alpha=\pm2`} />, which makes
      it a scaled Symmetric Dirichlet energy, SCIEN 0), or a volume term or constraint that removes it.</li>
    <li><strong>Zero bulk modulus.</strong> Mooney–Rivlin as written has
      <Tex tex={String.raw`\lambda_{\text{Lamé}}=-\tfrac23\mu_{\text{Lamé}}`} />: it does not resist volume change at all
      (Poisson ratio −1). It is meant to be paired with a volume term or an incompressibility constraint, which is what the
      paper's "mix and match" construction (Section 5) does systematically.</li>
    <li><strong>Equalize before comparing.</strong> Comparing a Stable Neo-Hookean material with native
      <Tex tex={String.raw`\lambda`} /> to a corotational one with the same <Tex tex={String.raw`\lambda`} /> compares two
      different stiffnesses: the paper reports the lowest vibration frequency off by 18% at ν = 0.2 (Figure 5).</li>
  </ul>

  <h2 id="checklist">A short checklist</h2>
  <ul>
    <li>Read Lamé parameters off <Tex tex={String.raw`\psi_{11}`} /> and <Tex tex={String.raw`\psi_{12}`} /> at rest; do not
      trust a material's parameter names.</li>
    <li>To change a material's nonlinearity but not its small-deformation behavior, use
      <Tex tex={String.raw`\psi_\alpha=\alpha^{-2}\,\psi(\lambda_1^\alpha,\lambda_2^\alpha,\lambda_3^\alpha)`} /> (Eq. 28): it keeps
      <Tex tex={L} /> and <Tex tex={M} /> and multiplies SCIEN by α.</li>
    <li>Check a new material by computing its row numerically, as the demo does.</li>
  </ul>
  <p>
    How the stretch-based form compares with the invariant forms, and why the paper prefers it, is the subject of
    <a href="/notes/three-ways-to-write-a-material">Three Ways to Write an Isotropic Material</a>, and its gradient and Hessian are
    in <a href="/notes/isotropic-gradient-hessian">The Gradient and Hessian of an Isotropic Energy</a>.
  </p>

