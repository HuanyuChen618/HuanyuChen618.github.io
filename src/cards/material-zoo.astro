<script>
  import { MATERIALS, PATHS, lameFromENu, restDerivs, lameFromDerivs, nuOf, scien, residualIndex } from '../scripts/material-zoo.js';
  const cv = document.getElementById('zoo-canvas') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const W = cv.width, H = cv.height;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim() || '#000';
  // categorical palette that reads on light and dark backgrounds
  const PAL = ['#4e79a7', '#f28e2b', '#e15759', '#76b7b2', '#59a14f', '#edc948', '#b07aa1', '#ff9da7', '#9c755f', '#8cd17d', '#499894', '#d37295', '#a0cbe8', '#ffbe7d', '#86bcb6', '#f1ce63', '#d4a6c8', '#bab0ac'];
  const DEFAULT = new Set(['lc', 'stvk', 'hencky', 'nh', 'snh', 'vcstvk']);
  const on = new Map(MATERIALS.map((m: any) => [m.id, DEFAULT.has(m.id)]));
  const color = new Map(MATERIALS.map((m: any, i: number) => [m.id, PAL[i % PAL.length]]));

  const legend = document.getElementById('zoo-legend')!;
  legend.innerHTML = MATERIALS.map((m: any) => `<label><input type="checkbox" data-id="${m.id}" ${on.get(m.id) ? 'checked' : ''}/> <span class="sw" style="background:${color.get(m.id)}"></span>${m.name}</label>`).join('');
  legend.querySelectorAll('input').forEach((el) => el.addEventListener('change', (e) => { const t = e.target as HTMLInputElement; on.set(t.dataset.id!, t.checked); update(); }));

  function curve(psi: (a: number, b: number, c: number) => number, path: any, qty: string, n = 400) {
    const pts: [number, number][] = [];
    for (let k = 0; k <= n; k++) {
      const s = path.lo + (path.hi - path.lo) * (k / n);
      let y: number;
      if (qty === 'energy') y = psi(...(path.f(s) as [number, number, number]));
      else { const h = 1e-5; y = (psi(...(path.f(s + h) as [number, number, number])) - psi(...(path.f(s - h) as [number, number, number]))) / (2 * h); }
      pts.push([s, y]);
    }
    return pts;
  }

  function update() {
    const nu = +$('zoo-nu').value; $('zoo-nuv').textContent = nu.toFixed(2);
    const path = (PATHS as any)[$('zoo-path').value], qty = $('zoo-qty').value;
    const { lamL, muL } = lameFromENu(1, nu);
    const shown = MATERIALS.filter((m: any) => on.get(m.id)).map((m: any) => ({ m, inst: m.make(lamL, muL) }));
    const curves = shown.map(({ m, inst }: any) => ({ id: m.id, pts: curve(inst.psi, path, qty) }));
    const lc = MATERIALS.find((m: any) => m.id === 'lc')!.make(lamL, muL);
    const quad = $('zoo-quad').checked ? curve(lc.psi, path, qty) : null;
    // y range: robust over visible finite values, anchored to the quadratic truncation
    const ys: number[] = []; [...curves.map((c: any) => c.pts), ...(quad ? [quad] : [])].forEach((pts: any) => pts.forEach((p: any) => Number.isFinite(p[1]) && ys.push(p[1])));
    ys.sort((a, b) => a - b);
    const q = (t: number) => ys.length ? ys[Math.min(ys.length - 1, Math.floor(t * (ys.length - 1)))] : 1;
    let y0 = qty === 'energy' ? 0 : q(0.04), y1 = q(0.94);
    if (qty === 'energy') y1 = Math.max(y1, 0.5); if (y1 - y0 < 1e-6) y1 = y0 + 1;
    const pad = 0.08 * (y1 - y0); y0 -= qty === 'energy' ? 0.02 * (y1 - y0) : pad; y1 += pad;
    const ink = css('--ink'), muted = css('--muted'), line = css('--line'), bg = css('--bg');
    const L = 58, R = 16, T = 18, B = 40;
    const sx = (s: number) => L + ((s - path.lo) / (path.hi - path.lo)) * (W - L - R), sy = (y: number) => T + (1 - (y - y0) / (y1 - y0)) * (H - T - B);
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = line; ctx.lineWidth = 1; ctx.beginPath();
    ctx.moveTo(L, T); ctx.lineTo(L, H - B); ctx.lineTo(W - R, H - B); ctx.stroke();
    if (y0 < 0 && y1 > 0) { ctx.beginPath(); ctx.moveTo(L, sy(0)); ctx.lineTo(W - R, sy(0)); ctx.stroke(); }
    ctx.setLineDash([3, 4]); ctx.beginPath(); ctx.moveTo(sx(1), T); ctx.lineTo(sx(1), H - B); if (path.lo < 0) { ctx.moveTo(sx(0), T); ctx.lineTo(sx(0), H - B); } ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = muted; ctx.font = '12px system-ui, sans-serif'; ctx.textAlign = 'center';
    for (let s = Math.ceil(path.lo * 2) / 2; s <= path.hi + 1e-9; s += 0.5) ctx.fillText(s.toFixed(1), sx(s), H - B + 16);
    ctx.fillText(`s  (${path.name})`, (L + W - R) / 2, H - 6);
    ctx.textAlign = 'right';
    for (let k = 0; k <= 4; k++) { const y = y0 + (k / 4) * (y1 - y0); ctx.fillText(y.toFixed(Math.abs(y1 - y0) < 2 ? 2 : 1), L - 6, sy(y) + 4); }
    ctx.save(); ctx.translate(14, (T + H - B) / 2); ctx.rotate(-Math.PI / 2); ctx.textAlign = 'center'; ctx.fillText(qty === 'energy' ? 'ψ / E' : '(dψ/ds) / E', 0, 0); ctx.restore();
    ctx.save(); ctx.beginPath(); ctx.rect(L, T, W - L - R, H - T - B); ctx.clip();
    const drawPts = (pts: [number, number][]) => { ctx.beginPath(); let pen = false; for (const [s, y] of pts) { if (!Number.isFinite(y)) { pen = false; continue; } const X = sx(s), Y = sy(Math.max(Math.min(y, y1 + 10 * (y1 - y0)), y0 - 10 * (y1 - y0))); if (pen) ctx.lineTo(X, Y); else { ctx.moveTo(X, Y); pen = true; } } ctx.stroke(); };
    curves.forEach((c: any) => { ctx.strokeStyle = color.get(c.id)!; ctx.lineWidth = 2.2; drawPts(c.pts); });
    if (quad) { ctx.strokeStyle = ink; ctx.lineWidth = 1.6; ctx.setLineDash([6, 5]); drawPts(quad); ctx.setLineDash([]); }
    ctx.restore();
    // live table: recompute each shown material's row from its formula and compare with the closed forms
    const rowsHtml = shown.map(({ m, inst }: any) => {
      const d = restDerivs(inst.psi), Lm = lameFromDerivs(d), ownNu = nuOf(inst.lamL, inst.muL);
      const sc = scien(d), ri = residualIndex(d), scT = m.scien(ownNu), riT = m.ri(ownNu);
      const z = (x: number) => (Math.abs(x) < 5e-4 ? 0 : x).toFixed(3);
      const cell = (a: number, b: number) => `<td${Math.abs(a - b) > 2e-3 ? ' class="off"' : ''}>${z(a)} <span class="muted">/ ${z(b)}</span></td>`;
      return `<tr><td><span class="sw" style="display:inline-block;width:1em;height:.3em;vertical-align:middle;margin-right:.4em;background:${color.get(m.id)}"></span>${m.name}</td>${cell(Lm.lamL, inst.lamL)}${cell(Lm.muL, inst.muL)}<td>${ownNu.toFixed(3)}</td>${cell(sc, scT)}${cell(ri, riT)}<td class="muted">${inst.native || ''}</td></tr>`;
    }).join('');
    (document.getElementById('zoo-read') as HTMLElement).innerHTML = shown.length ?
      `<table><tr><th>material</th><th>λ_Lamé computed / table</th><th>μ_Lamé computed / table</th><th>ν</th><th>SCIEN computed / table</th><th>RI computed / table</th><th>native</th></tr>${rowsHtml}</table>` +
      `<span class="muted">Target: E = 1, ν = ${nu.toFixed(2)}, so λ_Lamé = ${lamL.toFixed(3)}, μ_Lamé = ${muL.toFixed(3)}. "Computed" uses finite differences of each formula at rest (Eqs. 5, 6, 36, 40).</span>` : '<span class="muted">Tick a material above.</span>';
  }
  ['zoo-nu', 'zoo-path', 'zoo-qty', 'zoo-quad'].forEach((id) => { $(id).addEventListener('input', update); $(id).addEventListener('change', update); });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', update);
  update();
</script>
