---
// Layout for research notes: title block, one-line takeaway, body, source line, and a citation box with BibTeX.
// Citation metadata follows the Highwire (citation_*) tags that Google Scholar reads.
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import 'katex/dist/katex.min.css';
import '../styles/notes.css';
import { allNotes, AUTHOR, SITE, seriesOf, seriesUrl } from '../data/notes.js';

interface Props { slug: string }
const { slug } = Astro.props;
const n = allNotes.find((x) => x.slug === slug);
if (!n) throw new Error(`No notes.js entry for ${slug}`);
const { tldr, source } = n;
const navs = seriesOf(slug);
const url = `${SITE}/notes/${slug}/`;
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const year = n.published.slice(0, 4);
const key = `chen${year}${slug.split('-')[0]}`;
const bibtex = `@misc{${key},
  author       = {${AUTHOR}},
  title        = {${n.title}},
  year         = {${year}},
  howpublished = {\\url{${url}}},
  note         = {Research note, version ${n.version}, ${fmt(n.updated)}}
}`;
const plain = `${AUTHOR}. "${n.title}." Research note, version ${n.version}, ${fmt(n.updated)}. ${url}`;
---
<BaseLayout title={`${n.title} — Huanyu Chen`} description={n.summary}>
  <Fragment slot="head">
    <meta name="citation_title" content={n.title} />
    <meta name="citation_author" content={AUTHOR} />
    <meta name="citation_publication_date" content={n.published.replaceAll('-', '/')} />
    <meta name="citation_online_date" content={n.updated.replaceAll('-', '/')} />
    <meta name="citation_public_url" content={url} />
    <meta name="citation_language" content="en" />
    <meta name="dc.rights" content="CC BY 4.0" />
    <link rel="alternate" type="application/rss+xml" title="Huanyu Chen — Notes" href="/notes/rss.xml" />
  </Fragment>
  <article class="note">
    <p class="muted note-crumb"><a href="/notes">← Notes</a>{navs.map((v) => <> · <a href={seriesUrl(v.series.id, slug)}>{v.series.title}</a>, card {v.index} of {v.count}</>)}</p>
    <h1>{n.title}</h1>
    <p class="muted note-meta">
      {AUTHOR} · {fmt(n.published)}{n.updated !== n.published && <> · updated {fmt(n.updated)}</>} · version {n.version}
    </p>
    <div class="callout note-tldr"><strong>In one sentence.</strong> {tldr}</div>
    <p class="muted note-ai"><small>Based on my published papers and derivation notes. Drafting and interactive demos were
      done with AI assistance; the content was checked against the papers and verified numerically.</small></p>
    <slot />
    {source && <p class="muted note-source"><small><strong>Where this comes from.</strong> {source}</small></p>}
    {navs.map((v) => (
      <nav class="note-series-nav" aria-label={`${v.series.title} series`}>
        <span>{v.prev && <a href={`/notes/${v.prev.slug}`}>← {v.prev.title}</a>}</span>
        <span class="mid"><a href={seriesUrl(v.series.id, slug)}>{v.series.title}</a> · {v.index}/{v.count}</span>
        <span class="next">{v.next && <a href={`/notes/${v.next.slug}`}>{v.next.title} →</a>}</span>
      </nav>
    ))}
    <section class="note-cite" id="cite">
      <h2>How to cite</h2>
      <p>{plain}</p>
      <div class="bib-wrap">
        <pre class="bib"><code>{bibtex}</code></pre>
        <button type="button" class="bib-copy" data-bib={bibtex}>Copy BibTeX</button>
      </div>
      <p class="muted"><small>This note is licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>:
        you may reuse it, figures included, with attribution. Corrections bump the version number; the address stays the same.</small></p>
    </section>
  </article>
  <Comments />
  <script>
    document.querySelectorAll<HTMLButtonElement>('.bib-copy').forEach((b) => {
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.bib || ''); b.textContent = 'Copied'; }
        catch { b.textContent = 'Select and copy above'; }
        setTimeout(() => (b.textContent = 'Copy BibTeX'), 1800);
      });
    });
  </script>
</BaseLayout>
