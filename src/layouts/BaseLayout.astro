---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Huanyu Chen — Ph.D. candidate in Computer Science at USC. Computational mechanics and interpretable physical AI: shells, rods, nonlinear materials, contact and material measurement.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHome = Astro.url.pathname === '/';
// Structured data so search engines know this is Huanyu Chen's personal site.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Huanyu Chen',
  url: 'https://huanyuchen.com/',
  image: 'https://huanyuchen.com/profile.jpg',
  jobTitle: 'Ph.D. Candidate in Computer Science',
  email: 'mailto:huanyuc@usc.edu',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'University of Southern California', url: 'https://www.usc.edu/' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Science and Technology of China' },
  knowsAbout: ['computational mechanics', 'physics-based simulation', 'thin shells', 'elastic rods', 'nonlinear elasticity', 'physical AI'],
  sameAs: ['https://github.com/HuanyuChen618', 'https://sites.google.com/usc.edu/huanyu-chen'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Huanyu Chen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/profile.jpg', Astro.site).href} />
    <meta name="twitter:card" content="summary" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Nav />
    <main class="container">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Privacy-safe visit counter: at most one hit per browser, per page, per day. The server keeps only
      // aggregate city/page/day totals (no IP, no user agent, no per-visit record). See /visitors.
      (function () {
        var host = location.hostname;
        if (host === 'localhost' || host === '127.0.0.1' || host === '[::1]') return;
        var path = location.pathname.replace(/\/index\.html$/, '/').replace(/(.)\/$/, '$1');
        var day = new Date().toISOString().slice(0, 10);
        var key = 'visit:' + path;
        try { if (localStorage.getItem(key) === day) return; } catch (e) {}
        try {
          fetch('https://stats.huanyuchen.com/hit', {
            method: 'POST', keepalive: true, mode: 'cors', credentials: 'omit',
            headers: { 'Content-Type': 'text/plain' }, body: JSON.stringify({ path: path })
          }).then(function (r) { if (r.ok) { try { localStorage.setItem(key, day); } catch (e) {} } }).catch(function () {});
        } catch (e) {}
      })();
    </script>
  </body>
</html>
